{
  "name": "jv-flow",
  "version": "1.0.0",
  "description": "Real Estate Joint Venture Management System",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "test": "echo \"No tests specified\" && exit 0",
    "deploy:firebase": "npm run build && firebase deploy --only hosting",
    "deploy:vercel": "npm run build && vercel --prod",
    "deploy:netlify": "npm run build && netlify deploy --prod",
    "analyze": "npm run build -- --analyze",
    "preview:firebase": "npm run build && firebase serve",
    "preview:vercel": "vercel dev",
    "preview:netlify": "npm run build && netlify dev",
    "setup:demo": "chmod +x scripts/setup-demo.sh && ./scripts/setup-demo.sh",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase db reset && supabase db push",
    "docs": "echo 'Documentation available in PROJECT_DOCUMENTATION.md'",
    "health-check": "curl -f http://localhost:3000/health || npm run dev"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@supabase/supabase-js": "^2.39.0",
    "lucide-react": "^0.344.0",
    "recharts": "^2.10.0",
    "sonner": "^1.4.0",
    "motion": "^10.16.0",
    "react-hook-form": "^7.55.0",
    "@hookform/resolvers": "^3.3.0",
    "zod": "^3.22.0",
    "date-fns": "^3.2.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.2.0",
    "class-variance-authority": "^0.7.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "tailwindcss": "^4.0.0-alpha.7",
    "@tailwindcss/vite": "^4.0.0-alpha.7"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "real-estate",
    "joint-venture",
    "management",
    "dashboard",
    "react",
    "typescript",
    "supabase"
  ],
  "author": "JV-Flow Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/jv-flow.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/jv-flow/issues"
  },
  "homepage": "https://github.com/your-username/jv-flow#readme"
}